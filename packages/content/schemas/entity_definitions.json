{
  "additionalProperties": false,
  "type": "object",
  "required": ["id", "components"],
  "properties": {
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "includes": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "components": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "resource_source": {
          "additionalProperties": false,
          "type": "object",
          "required": ["policy", "outputs"],
          "properties": {
            "policy": {
              "anyOf": [
                {
                  "const": "infinite_rate",
                  "type": "string"
                },
                {
                  "const": "finite_deposit",
                  "type": "string"
                },
                {
                  "const": "regenerating_deposit",
                  "type": "string"
                },
                {
                  "const": "slot_dependent",
                  "type": "string"
                },
                {
                  "const": "area_dependent",
                  "type": "string"
                },
                {
                  "const": "condition_dependent",
                  "type": "string"
                }
              ]
            },
            "outputs": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": ["resource", "quantity_per_tick"],
                "properties": {
                  "resource": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "quantity_per_tick": {
                    "minimum": 0,
                    "type": "integer"
                  }
                }
              }
            },
            "depletion": {
              "anyOf": [
                {
                  "const": "none",
                  "type": "string"
                },
                {
                  "const": "finite",
                  "type": "string"
                },
                {
                  "const": "regenerating",
                  "type": "string"
                }
              ]
            },
            "initial_quantity": {
              "minimum": 0,
              "type": "integer"
            },
            "regeneration_per_tick": {
              "minimum": 0,
              "type": "integer"
            },
            "maximum_quantity": {
              "minimum": 0,
              "type": "integer"
            },
            "scale_by_property": {
              "minLength": 1,
              "type": "string"
            },
            "condition": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "producer": {
          "additionalProperties": false,
          "type": "object",
          "required": ["recipes", "process_slots", "input_inventory", "output_inventory"],
          "properties": {
            "recipes": {
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "process_slots": {
              "minimum": 1,
              "type": "integer"
            },
            "input_inventory": {
              "minLength": 1,
              "pattern": "^(?:location\\.)?[a-z0-9_]+$",
              "type": "string"
            },
            "output_inventory": {
              "minLength": 1,
              "pattern": "^(?:location\\.)?[a-z0-9_]+$",
              "type": "string"
            }
          }
        },
        "residence": {
          "additionalProperties": false,
          "type": "object",
          "required": ["population_tier", "capacity", "growth_policy"],
          "properties": {
            "population_tier": {
              "minLength": 1,
              "type": "string"
            },
            "capacity": {
              "minimum": 1,
              "type": "integer"
            },
            "initial_population": {
              "minimum": 0,
              "type": "integer"
            },
            "growth_policy": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "storage_access": {
          "additionalProperties": false,
          "type": "object",
          "required": ["inventory"],
          "properties": {
            "inventory": {
              "minLength": 1,
              "pattern": "^(?:location\\.)?[a-z0-9_]+$",
              "type": "string"
            }
          }
        },
        "storage_provider": {
          "additionalProperties": false,
          "type": "object",
          "required": ["inventory"],
          "properties": {
            "inventory": {
              "minLength": 1,
              "pattern": "^(?:location\\.)?[a-z0-9_]+$",
              "type": "string"
            },
            "capacity": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "total": {
                  "minimum": 0,
                  "type": "integer"
                },
                "per_resource": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            },
            "throughput": {
              "minimum": 0,
              "type": "integer"
            }
          }
        },
        "construction": {
          "additionalProperties": false,
          "type": "object",
          "required": ["duration_ticks", "costs", "commit_policy"],
          "properties": {
            "duration_ticks": {
              "minimum": 0,
              "type": "integer"
            },
            "costs": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": ["resource", "quantity"],
                "properties": {
                  "resource": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "quantity": {
                    "minimum": 0,
                    "type": "integer"
                  }
                }
              }
            },
            "commit_policy": {
              "anyOf": [
                {
                  "const": "start",
                  "type": "string"
                },
                {
                  "const": "continuous",
                  "type": "string"
                },
                {
                  "const": "completion",
                  "type": "string"
                }
              ]
            },
            "deconstruction": {
              "additionalProperties": false,
              "type": "object",
              "required": ["duration_ticks", "returns"],
              "properties": {
                "duration_ticks": {
                  "minimum": 0,
                  "type": "integer"
                },
                "returns": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": ["resource", "quantity"],
                    "properties": {
                      "resource": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "quantity": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    }
                  }
                },
                "cancel_reservations": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "placement": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "capacity_cost": {
              "minimum": 0,
              "type": "integer"
            },
            "footprint": {
              "type": "array",
              "items": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "minimum": 1,
                  "type": "integer"
                }
              ],
              "additionalItems": false,
              "minItems": 2,
              "maxItems": 2
            },
            "working_area": {
              "additionalProperties": false,
              "type": "object",
              "required": ["cells"],
              "properties": {
                "cells": {
                  "minimum": 0,
                  "type": "integer"
                },
                "exclusive": {
                  "type": "boolean"
                }
              }
            },
            "requires_slot": {
              "minLength": 1,
              "type": "string"
            },
            "conditions": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "connectivity": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["requires"],
              "properties": {
                "requires": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["provides"],
              "properties": {
                "provides": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          ]
        },
        "maintenance": {
          "additionalProperties": false,
          "type": "object",
          "required": ["interval_ticks", "inputs", "charge_policy", "shortage_policy"],
          "properties": {
            "interval_ticks": {
              "minimum": 1,
              "type": "integer"
            },
            "inputs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": ["resource", "quantity"],
                "properties": {
                  "resource": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "quantity": {
                    "minimum": 1,
                    "type": "integer"
                  }
                }
              }
            },
            "charge_policy": {
              "anyOf": [
                {
                  "const": "while_exists",
                  "type": "string"
                },
                {
                  "const": "while_enabled",
                  "type": "string"
                },
                {
                  "const": "while_active",
                  "type": "string"
                },
                {
                  "const": "while_processing",
                  "type": "string"
                }
              ]
            },
            "shortage_policy": {
              "anyOf": [
                {
                  "const": "deactivate_entity",
                  "type": "string"
                },
                {
                  "const": "scale",
                  "type": "string"
                },
                {
                  "const": "accumulate_debt",
                  "type": "string"
                },
                {
                  "const": "ignore",
                  "type": "string"
                },
                {
                  "const": "trigger_transition",
                  "type": "string"
                },
                {
                  "const": "owner_deficit_policy",
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    }
  }
}
