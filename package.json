{
  "name": "aesfw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Abstract Economic Simulation Framework - theme-free, deterministic, headless framework for economic city-building games.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node tools/lint-theme-free.mjs",
    "depcruise": "depcruise packages reference",
    "test": "vitest run",
    "test:property": "vitest run \"**/*.prop.test.ts\"",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "trace": "node tools/trace/index.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm depcruise && pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
