{
  "name": "@aesfw-ref/client-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference browser client: plain DOM and SVG, no UI framework. Sees the simulation only through protocol DTOs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "VITE_BASE=/AESFW/ vite build",
    "preview": "vite preview",
    "prebuild": "node scripts/gen-presentation.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aesfw/host-web": "workspace:*",
    "@aesfw/protocol": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "jsdom": "27.0.0",
    "@axe-core/playwright": "4.11.0"
  }
}
